{
    "manifest_version": 3,

    "name": "Phishing Protection AI",

    "version": "1.0.0",

    "description": "AI-powered phishing detection and protection browser extension.",

    "permissions": [
        "activeTab",
        "storage",
        "tabs"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "background": {
        "service_worker": "background.js"
    }
}